{
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm run typecheck:libs && pnpm --filter @workspace/api-server run build:vercel",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/vercel-entry.mjs" }
  ],
  "typescript": {
    "ignoreBuildErrors": true
  }
}
